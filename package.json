{
  "name": "1panel-app-workshop",
  "type": "module",
  "version": "2.5.0",
  "packageManager": "pnpm@12.18.0",
  "description": "One-stop build for 1Panel local applications",
  "author": "Corentin Th <corentin.thomasset74+it-tools@gmail.com> (https://corentin.tech)",
  "license": "GNU GPLv3",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooneyy/1panel-app-workshop"
  },
  "keywords": [
    "productivity",
    "converter",
    "website",
    "vuejs",
    "tools",
    "frontend",
    "tool",
    "developer-tools",
    "developer-productivity"
  ],
  "scripts": {
    "build": "vite build",
    "build:gh-pages": "vite build --base=/1panel-app-workshop/",
    "build:package": "vite build && pnpm package && pnpm clean",
    "build:package:gh-pages": "vite build --base=/1panel-app-workshop/ && pnpm package && pnpm clean",
    "build:preview": "pnpm clean && pnpm build && pnpm preview",
    "clean": "rimraf dist",
    "dev": "vite",
    "dev:gh-pages": "vite --base=/1panel-app-workshop/",
    "package": "tar -czf publish.tgz -C ./dist .",
    "package2zip": "tar --format=zip -cf publish.tar.zip -C ./dist .",
    "preview": "vite preview --port 5050",
    "release": "standard-version && pnpm release:tag",
    "release:tag": "node ./scripts/release-tag.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "vue-tsc --build --force",
    "winrar": "winrar a -r -ep1 publish.zip ./dist/*"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "1.6.0",
    "@tabler/icons-vue": "3.51.0",
    "@vicons/tabler": "0.13.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/head": "2.0.0",
    "@vueuse/router": "^15.0.0",
    "date-fns": "4.4.0",
    "dompurify": "3.4.17",
    "file-saver": "2.0.5",
    "flexsearch": "0.8.212",
    "highlight.js": "11.12.0",
    "js-base64": "3.9.6",
    "jszip": "3.10.2",
    "lodash": "4.18.1",
    "marked": "18.2.0",
    "monaco-editor": "0.57.0",
    "naive-ui": "2.45.3",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@iconify-json/mdi": "1.2.3",
    "@intlify/unplugin-vue-i18n": "11.2.8",
    "@types/file-saver": "2.0.7",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/compiler-sfc": "3.5.45",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "less": "4.9.1",
    "rimraf": "6.1.4",
    "standard-version": "9.5.0",
    "typescript": "6.0.3",
    "unocss": "66.12.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-icons": "24.0.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.7",
    "vite-plugin-node-polyfills": "0.28.0",
    "vite-svg-loader": "5.1.3",
    "vue-tsc": "3.3.14"
  }
}
